PUBLIC_DATA_MODE=fixture
PUBLIC_FIXTURE_ORIGIN=

# Existing LauncherUI Firebase web configuration (required for firebase mode)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Explicit local emulator transport
PUBLIC_USE_FIREBASE_EMULATORS=false
PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9195
PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
PUBLIC_FIRESTORE_EMULATOR_PORT=8195
